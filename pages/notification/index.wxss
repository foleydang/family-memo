.container { padding: 0 16rpx; }
.header-bar { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 16rpx; }
.page-title { font-size: 34rpx; font-weight: bold; }
.read-all-btn { font-size: 26rpx; color: #1aad19; }
.loading, .empty { text-align: center; padding: 100rpx; color: #999; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: #999; }
.notif-item { display: flex; align-items: flex-start; padding: 24rpx 16rpx; border-bottom: 1rpx solid #f0f0f0; position: relative; }
.notif-item.unread { background: #f6fdf6; }
.notif-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #1aad19; margin: 8rpx 16rpx 0 0; flex-shrink: 0; }
.notif-body { flex: 1; }
.notif-title { display: block; font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 8rpx; }
.notif-content { display: block; font-size: 26rpx; color: #666; margin-bottom: 8rpx; }
.notif-time { font-size: 22rpx; color: #bbb; }
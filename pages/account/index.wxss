.container { padding: 0 16rpx 160rpx; }
.header-bar { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 16rpx; }
.month-nav { display: flex; align-items: center; font-size: 32rpx; font-weight: bold; }
.nav-arrow { font-size: 40rpx; padding: 0 16rpx; color: #999; }
.stats-toggle { font-size: 26rpx; color: #1aad19; padding: 8rpx 16rpx; background: #f0f9f0; border-radius: 8rpx; }
.header-actions { display: flex; gap: 16rpx; }

/* 统计面板 */
.stats-panel { background: #fff; border-radius: 16rpx; padding: 24rpx; margin: 0 8rpx 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.stat-row { display: flex; justify-content: space-around; margin-bottom: 24rpx; }
.stat-item { text-align: center; }
.stat-label { display: block; font-size: 22rpx; color: #999; margin-bottom: 8rpx; }
.stat-value { font-size: 36rpx; font-weight: bold; }
.stat-item.expense .stat-value { color: #e74c3c; }
.stat-item.income .stat-value { color: #1aad19; }
.stat-item.balance .stat-value { color: #333; }
.stat-item.balance .stat-value.red { color: #e74c3c; }
.stat-item.balance .stat-value.green { color: #1aad19; }
.rank-title { font-size: 26rpx; font-weight: bold; margin: 16rpx 0 8rpx; color: #333; }
.rank-list { margin: 8rpx 0; }
.rank-item { display: flex; align-items: center; padding: 8rpx 0; font-size: 24rpx; }
.rank-cat { width: 80rpx; color: #666; }
.rank-bar-wrap { flex: 1; height: 12rpx; background: #f0f0f0; border-radius: 6rpx; margin: 0 16rpx; overflow: hidden; }
.rank-bar { height: 100%; background: linear-gradient(90deg, #ff6b6b, #ff8e53); border-radius: 6rpx; transition: width 0.3s; }
.rank-amount { color: #999; min-width: 120rpx; text-align: right; }

/* 筛选 */
.filter-bar { display: flex; margin: 0 8rpx 16rpx; gap: 16rpx; }
.filter-item { padding: 10rpx 28rpx; border-radius: 32rpx; font-size: 26rpx; background: #f5f5f5; color: #666; }
.filter-item.active.expense { background: #ffebee; color: #e74c3c; font-weight: bold; }
.filter-item.active.income { background: #e8f5e9; color: #1aad19; font-weight: bold; }

/* 账单 */
.date-group { margin: 0 8rpx 16rpx; background: #fff; border-radius: 16rpx; overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.date-header { display: flex; justify-content: space-between; padding: 20rpx 24rpx; background: #fafafa; border-bottom: 1rpx solid #f0f0f0; }
.date-text { font-size: 28rpx; font-weight: bold; color: #333; }
.date-sum { font-size: 24rpx; color: #999; }
.account-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 24rpx; border-bottom: 1rpx solid #f9f9f9; }
.account-item:last-child { border-bottom: none; }
.item-left { flex: 1; }
.item-category { display: inline-block; font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 6rpx; margin-bottom: 6rpx; background: #f5f5f5; color: #666; }
.item-title { display: block; font-size: 28rpx; color: #333; margin-bottom: 4rpx; }
.item-payer { font-size: 22rpx; color: #999; }
.item-right { text-align: right; }
.item-amount { font-size: 32rpx; font-weight: bold; display: block; }
.expense-color { color: #e74c3c; }
.income-color { color: #1aad19; }
.item-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 8rpx; opacity: 0.5; }
.item-actions text { padding: 4rpx; }
.loading-card { text-align: center; padding: 80rpx; color: #999; }
.empty-state { text-align: center; padding: 100rpx 40rpx; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 16rpx; }
.empty-text { font-size: 30rpx; color: #999; display: block; margin-bottom: 8rpx; }
.empty-desc { font-size: 24rpx; color: #bbb; }

/* FAB */
.fab { position: fixed; bottom: 40rpx; right: 40rpx; width: 100rpx; height: 100rpx; border-radius: 50%; background: linear-gradient(135deg, #1aad19, #0d8a0d); display: flex; align-items: center; justify-content: center; box-shadow: 0 6rpx 20rpx rgba(26,173,25,0.35); z-index: 100; }
.fab-text { font-size: 48rpx; color: #fff; line-height: 1; }

/* Modal */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); z-index: 200; }
.modal { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 32rpx; z-index: 201; max-height: 80vh; overflow-y: auto; }
.modal-title { font-size: 34rpx; font-weight: bold; text-align: center; margin-bottom: 24rpx; }
.type-switch { display: flex; margin-bottom: 24rpx; gap: 16rpx; }
.type-btn { flex: 1; text-align: center; padding: 16rpx; border-radius: 12rpx; font-size: 28rpx; background: #f5f5f5; color: #666; }
.type-btn.active.expense { background: #ffebee; color: #e74c3c; font-weight: bold; }
.type-btn.active.income { background: #e8f5e9; color: #1aad19; font-weight: bold; }
.form-item { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 26rpx; color: #999; margin-bottom: 10rpx; }
.form-input { width: 100%; padding: 16rpx; border: 1rpx solid #e5e5e5; border-radius: 12rpx; font-size: 28rpx; box-sizing: border-box; }
.amount-input { font-size: 48rpx; font-weight: bold; text-align: center; padding: 24rpx; }
.category-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.cat-item { padding: 10rpx 22rpx; border-radius: 32rpx; font-size: 24rpx; background: #f5f5f5; color: #666; }
.cat-item.selected { background: #e8f5e9; color: #1aad19; font-weight: bold; }
.picker-val { padding: 16rpx; border: 1rpx solid #e5e5e5; border-radius: 12rpx; font-size: 28rpx; color: #333; }
.modal-btns { display: flex; gap: 16rpx; margin-top: 32rpx; }
.btn-cancel { flex: 1; padding: 18rpx; border-radius: 12rpx; font-size: 28rpx; background: #f5f5f5; color: #666; text-align: center; border: none; }
.btn-submit { flex: 2; padding: 18rpx; border-radius: 12rpx; font-size: 28rpx; background: linear-gradient(135deg, #1aad19, #0d8a0d); color: #fff; text-align: center; border: none; }
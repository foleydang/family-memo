.container { padding: 16rpx; }
.search-bar { display: flex; align-items: center; background: #f5f5f5; border-radius: 16rpx; padding: 16rpx 24rpx; margin-bottom: 24rpx; }
.search-input { flex: 1; font-size: 28rpx; }
.clear-btn { font-size: 32rpx; color: #999; padding: 0 16rpx; }
.loading, .empty-hint, .no-result { text-align: center; padding: 80rpx; color: #999; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; }
.result-count { font-size: 24rpx; color: #999; margin-bottom: 16rpx; }
.section { margin-bottom: 24rpx; }
.section-title { font-size: 28rpx; font-weight: bold; color: #333; padding: 12rpx 0; border-bottom: 1rpx solid #f0f0f0; margin-bottom: 8rpx; }
.result-item { display: flex; align-items: center; padding: 20rpx 8rpx; border-bottom: 1rpx solid #f9f9f9; }
.item-main { flex: 1; }
.item-title { display: block; font-size: 28rpx; color: #333; margin-bottom: 4rpx; }
.item-meta { font-size: 22rpx; color: #999; }
.item-badge { color: #ccc; font-size: 32rpx; }
.item-amount { font-weight: bold; font-size: 28rpx; }
.item-amount.red { color: #e74c3c; }
.item-amount.green { color: #1aad19; }